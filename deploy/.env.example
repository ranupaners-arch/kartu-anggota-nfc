# ── Konfigurasi produksi Kartu Anggota ─────────────────────────────────────────
# Salin ke deploy/.env lalu isi. Nilai bertanda WAJIB harus diganti.
# Buat kunci acak:  openssl rand -base64 32   /   openssl rand -hex 32

# Domain server (DNS A record mengarah ke IP VPS). Caddy mengurus HTTPS otomatis.
SITE_ADDRESS=absen.contoh.id                       # WAJIB
APP_URL=https://absen.contoh.id                     # WAJIB, sama dengan domain di atas

APP_NAME="Kartu Anggota NFC"
# Nama yang tampil di app saat petugas menghubungkan (self-hosted: nama organisasi)
INSTANCE_NAME="Nama Organisasi"                     # WAJIB
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GANTI_DENGAN_openssl_rand_-base64_32  # WAJIB
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# Kunci tanda tangan kartu NFC. JANGAN diganti setelah kartu pertama ditulis.
CARD_PAYLOAD_PREFIX=card
CARD_ACTIVE_KEY=k1
CARD_KEY_k1=GANTI_DENGAN_openssl_rand_-hex_32       # WAJIB

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kartu_anggota
DB_USERNAME=kartu_anggota
DB_PASSWORD=GANTI_PASSWORD_DATABASE                 # WAJIB

REDIS_CLIENT=phpredis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Backup harian (database + foto/bukti/ekspor) ke deploy/backups
BACKUP_AT=02:00
BACKUP_TZ=Asia/Jakarta
BACKUP_KEEP_DAYS=14
